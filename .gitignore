# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# Dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# Testing
/coverage

# Next.js
/.next/
/out/
/build

# Local Databases (Prisma & SQLite)
dev.db
*.db
*.db-journal
*.sqlite
*.sqlite3
prisma/dev.db

# User Uploaded Resumes & Files
/public/uploads/*
!/public/uploads/.gitkeep

# Environment Files
.env
.env*.local
.env.production
.env.staging
!.env.example

# Vercel
.vercel

# TypeScript & Debug Logs
*.tsbuildinfo
next-env.d.ts
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# System & IDE files
.DS_Store
Thumbs.db
.vscode/
.idea/
*.pem

