// Prisma Schema for AI Career Intelligence Platform
// Using SQLite for local development

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(cuid())
  name          String
  email         String    @unique
  passwordHash  String
  avatarUrl     String?
  theme         String    @default("dark")
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  applications   Application[]
  resumes        Resume[]
  calendarEvents CalendarEvent[]
}

model Resume {
  id            String    @id @default(cuid())
  userId        String
  name          String
  type          String    @default("General") // General, Backend, Frontend, Embedded, AI, Internship
  usageCount    Int       @default(0)
  interviewRate Float     @default(0)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  user     User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  versions ResumeVersion[]

  @@index([userId])
}

model ResumeVersion {
  id            String   @id @default(cuid())
  resumeId      String
  versionNumber Int
  filePath      String
  fileName      String
  fileSize      Int
  isActive      Boolean  @default(true)
  uploadedAt    DateTime @default(now())

  // AI-extracted structured profile (stored as JSON)
  profileData   String?  // JSON: skills, technologies, projects, etc.
  rawText       String?
  analyzedAt    DateTime?

  resume       Resume        @relation(fields: [resumeId], references: [id], onDelete: Cascade)
  applications Application[]

  @@index([resumeId])
}

model Application {
  id              String   @id @default(cuid())
  userId          String
  resumeVersionId String?
  company         String
  role            String
  location        String?
  jobUrl          String?
  salaryMin       Float?
  salaryMax       Float?
  applicationDate DateTime?
  deadline        DateTime?
  priority        String   @default("Medium") // Low, Medium, High, Critical
  status          String   @default("Active")  // Active, Paused, Closed
  stage           String   @default("Wishlist") // Kanban stage
  notes           String?
  recruiterName   String?
  recruiterEmail  String?
  recruiterPhone  String?
  kanbanOrder     Int      @default(0)

  // Job Description (inline for simplicity)
  jobDescription  String?

  // AI Analysis scores (cached)
  resumeMatch         Float?
  atsScore            Float?
  readinessScore      Float?
  applicationStrength Float?

  // AI Analysis details (JSON)
  analysisData    String? // JSON: skill gaps, suggestions, explanations

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  resumeVersion  ResumeVersion?  @relation(fields: [resumeVersionId], references: [id], onDelete: SetNull)
  timelineEvents TimelineEvent[]
  calendarEvents CalendarEvent[]

  @@index([userId])
  @@index([userId, stage])
}

model TimelineEvent {
  id            String   @id @default(cuid())
  applicationId String
  eventType     String   // created, stage_change, resume_selected, ai_analysis, note_added, etc.
  title         String
  description   String?
  metadata      String?  // JSON for extra data
  occurredAt    DateTime @default(now())

  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([applicationId])
}

model CalendarEvent {
  id            String   @id @default(cuid())
  userId        String
  applicationId String?
  eventType     String   // application_date, deadline, oa, interview, offer_expiry, followup
  title         String
  description   String?
  startTime     DateTime
  endTime       DateTime?
  color         String   @default("#3b82f6")
  reminderSent  Boolean  @default(false)
  reminderTime  DateTime?
  createdAt     DateTime @default(now())

  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  application Application? @relation(fields: [applicationId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([userId, startTime])
}
